# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default; swap for postgres in prod)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_WORKSPACE_ID=

# Optional: S3 for user uploads (leave blank to use local disk storage)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1

# PDF upload limits
MAX_PDF_SIZE_MB=50

# Optional: email backend for password reset (defaults to console backend,
# which prints emails to the runserver log - fine for local dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@cornote.local
